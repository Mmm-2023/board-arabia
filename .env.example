# LinkedIn Connect stays off unless this is the exact string true at build time.
# Leave false. Do not put LinkedIn OAuth credentials in this file.
VITE_LINKEDIN_CONNECT=false

# Edge secrets for the admitted-member LinkedIn share. Not read by the client.
# Leave unset. The exact string true turns a flag on. Anything else stays off.
# ADMIT_LI_SHARE_EMAIL_ENABLED=false
# ADMIT_LI_SHARE_HOME_CARD_ENABLED=false
# ADMIT_LI_SHARE_REMINDER_ENABLED=false
# ADMIT_LI_SHARE_DRYRUN_TO=staff@example.com
# ADMIT_LI_SHARE_REMINDER_SECRET is a GitHub Actions secret and an Edge secret. Do not commit a value.


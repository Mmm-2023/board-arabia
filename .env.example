# Site analytics stays off until the privacy go-live gates pass.
# Only the exact string true turns capture on. Anything else stays off.
# No PostHog script loads while this is false.
VITE_ANALYTICS_ENABLED=false

# anonymous_counts (default) or none. none sends nothing until Accept.
VITE_ANALYTICS_PRECONSENT_MODE=anonymous_counts

# PostHog Cloud EU project key. Placeholder only. Do not commit a live key.
VITE_POSTHOG_KEY=phc_PLACEHOLDER

# PostHog Cloud EU host. Do not point this at another region.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Edge only. Exact string true lets the approve function send the approved event.
# Leave unset. Do not put a key in this file.
# ANALYTICS_ENABLED=
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# MEMBERSHIP_REMINDER_SECRET=

# Public Turnstile site key. The secret TURNSTILE_SECRET_KEY stays in the Edge secret store.
# Leave unset until the site key is supplied. Do not put the secret in this file.
# VITE_TURNSTILE_SITE_KEY=

# Public consideration CTAs stay on /apply unless this is the exact string true at build time.
# Leave false. True switches those CTAs to Register for consideration and /register.
VITE_TWO_TIER_REGISTER_ENABLED=false

# LinkedIn Connect stays off unless this is the exact string true at build time.
# Leave false. Do not put LinkedIn OAuth credentials in this file.
VITE_LINKEDIN_CONNECT=false

# Edge secrets for the admitted-member LinkedIn share. Not read by the client.
# Leave unset. The exact string true turns a flag on. Anything else stays off.
# ADMIT_LI_SHARE_EMAIL_ENABLED=false
# ADMIT_LI_SHARE_HOME_CARD_ENABLED=false
# ADMIT_LI_SHARE_REMINDER_ENABLED=false
# ADMIT_LI_SHARE_DRYRUN_TO=staff@example.com
# ADMIT_LI_SHARE_REMINDER_SECRET is a GitHub Actions secret and an Edge secret. Do not commit a value.

# Board Arabia. Supabase (project ref: iirqbizwanyhgkhanntq)
